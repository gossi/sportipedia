{
  "elixirLS.projectDir": "./services/api/",
  "elixirLS.dotFormatter": ".formatter.exs",
  "elixirLS.mcpPort": 4328, // Optional: set a fixed port to avoid guessing
  "elixirLS.mcpEnabled": true,
  "[glimmer-ts]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.foldingStrategy": "indentation",
    "editor.codeActionsOnSave": {
      "source.fixAll": "never",
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "never"
    }
  },
  "i18n-ally-next.localesPaths": [
		"apps/catalog/locales",
		"apps/admin/locales",
		"support/ui/locales",
		"support/user/locales"
	]
}