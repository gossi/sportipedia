{
  "extends": "@ember/app-tsconfig",
  "include": [
    "src",
    "tests",
    "types",
    ".storybook/**/*"
  ],
  "compilerOptions": {
    "allowJs": true,
    "target": "esnext",
    "paths": {
      "#/*": [
        "./src/*"
      ],
      "#auth/*": [
        "./src/support/auth/*"
      ],
      "#support/*": [
        "./src/support/*"
      ],
      "#equipment": [
        "./src/equipment/index.ts"
      ],
      "#equipment-test-support": [
        "./tests/equipment/support/index.ts"
      ],
      "#user": [
        "./src/user/index.ts"
      ],
      "#storybook/*": ["./.storybook/*"],
      "#tests/*": [
        "./tests/*"
      ]
    },
    "types": [
      "ember-source/types",
      "@glint/ember-tsc/types",
      "@embroider/core/virtual",
      "vite/client",
      "ember-intl/types",
      "unplugin-icons/types/ember",
      "msw-storybook-addon/types"
    ]
  }
}