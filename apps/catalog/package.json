{
  "name": "@sportipedia/catalog",
  "type": "module",
  "imports": {
    "#equipment": "./src/equipment/index.ts",
    "#user": "./src/user/index.ts",
    "#auth/*": "./src/support/auth/*",
    "#support/*": "./src/support/*",
    "#/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "sb": "storybook dev --port 5101",
    "build-storybook": "storybook build",
    "build": "vite build",
    "dev": "vite",
    "lint": "pnpm run '/^lint:(?!.*(fix)).*$/'",
    "lint:fix": "pnpm run '/^lint:[^:]*:fix/'",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "apidoc": "node scripts/apidoc.mjs"
  },
  "dependencies": {
    "@sportipedia/ui": "workspace:*",
    "@sportipedia/user": "workspace:*",
    "ember-intl": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "catalog:build",
    "@babel/plugin-transform-runtime": "catalog:build",
    "@babel/plugin-transform-typescript": "catalog:build",
    "@babel/runtime": "catalog:build",
    "@ember/app-tsconfig": "catalog:ember",
    "@ember/test-helpers": "^5.0.0",
    "@embroider/core": "catalog:ember",
    "@embroider/macros": "catalog:ember",
    "@embroider/router": "catalog:ember",
    "@embroider/vite": "catalog:ember",
    "@glimmer/component": "catalog:ember",
    "@glint/ember-tsc": "catalog:ember",
    "@glint/template": "catalog:ember",
    "@glint/tsserver-plugin": "catalog:ember",
    "@gossi/config-eslint": "catalog:lint",
    "@gossi/config-prettier": "catalog:lint",
    "@gossi/config-stylelint": "catalog:lint",
    "@gossi/config-template-lint": "catalog:lint",
    "@hokulea/core": "catalog:lib",
    "@hokulea/ember": "catalog:lib",
    "@hokulea/theme-moana": "catalog:lib",
    "@iconify-json/material-symbols": "catalog:icons",
    "@iconify-json/ph": "catalog:icons",
    "@rollup/plugin-babel": "catalog:build",
    "@standard-schema/spec": "^1.1.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@theemo/ember": "catalog:lib",
    "@theemo/vite": "catalog:lib",
    "@vitest/ui": "catalog:test",
    "@warp-drive/core": "catalog:ember",
    "@warp-drive/ember": "catalog:ember",
    "@warp-drive/json-api": "catalog:ember",
    "@warp-drive/utilities": "catalog:ember",
    "babel-plugin-debug-macros": "catalog:build",
    "babel-plugin-ember-template-compilation": "catalog:build",
    "better-auth": "catalog:lib",
    "decorator-transforms": "catalog:build",
    "ember-ability": "catalog:ember",
    "ember-better-auth": "catalog:ember",
    "ember-command": "catalog:ember",
    "ember-concurrency": "catalog:ember",
    "ember-element-helper": "catalog:ember",
    "ember-link": "catalog:ember",
    "ember-modifier": "catalog:ember",
    "ember-page-title": "catalog:ember",
    "ember-resolver": "catalog:ember",
    "ember-resources": "catalog:ember",
    "ember-scoped-css": "catalog:ember",
    "ember-source": "catalog:ember",
    "ember-storybook": "^0.1.6",
    "ember-strict-application-resolver": "catalog:ember",
    "ember-template-lint": "catalog:lint",
    "ember-truth-helpers": "catalog:ember",
    "eslint": "catalog:lint",
    "eslint-plugin-ember": "catalog:lint",
    "prettier": "catalog:lint",
    "storybook": "^10.5.10",
    "stylelint": "catalog:lint",
    "temporal-polyfill": "catalog:lib",
    "typedoc": "^0.28.20",
    "typedoc-plugin-ember": "^0.0.3",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-inline-sources": "^1.3.0",
    "typescript": "catalog:build",
    "unplugin-icons": "catalog:icons",
    "vite": "catalog:build",
    "vitest": "catalog:test"
  },
  "engines": {
    "node": ">=24"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  }
}
